{
  "rules": {
    "couples": {
      "$coupleId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (data.child('members').child(auth.uid).exists() || !data.exists())",

        "members": {
          ".validate": "newData.hasChildren()",
          "$memberId": {
            ".write": "auth != null && auth.uid === $memberId",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "photo": {
              ".validate": "!newData.exists() || newData.isString()"
            },
            "email": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            }
          }
        },

        "expenses": {
          "$expenseId": {
            ".validate": "newData.hasChild('amount') && newData.hasChild('paidBy') && newData.hasChild('category') && newData.hasChild('date')",
            "amount": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 100000"
            },
            "paidBy": {
              ".validate": "newData.isString()"
            },
            "category": {
              ".validate": "newData.isString() && newData.val().matches(/^(cena|casa|viaje|capricho|super|otro)$/)"
            },
            "description": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}/)"
            },
            "amountEUR": {
              ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)"
            },
            "currency": {
              ".validate": "!newData.exists() || newData.isString()"
            },
            "settlement": {
              ".validate": "!newData.exists() || newData.isBoolean()"
            },
            "split": {
              "type": {
                ".validate": "newData.isString() && newData.val().matches(/^(equal|payer|custom)$/)"
              },
              "shares": {
                "$uid": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "goals": {
          "$goalId": {
            ".validate": "newData.hasChild('name') && newData.hasChild('target')",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "target": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 10000000"
            },
            "saved": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000000"
            },
            "icon": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20)"
            },
            "emoji": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)"
            },
            "createdAt": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "inviteCode": {
          ".validate": "newData.isString()"
        },

        "createdAt": {
          ".validate": "newData.isNumber()"
        },

        "subscription": {
          ".read": "auth != null && data.parent().child('members').child(auth.uid).exists()",
          ".write": "auth != null && (data.parent().child('members').child(auth.uid).exists() || !data.exists())",
          "plan": {
            ".validate": "newData.isString()"
          },
          "expenseCount": {
            ".validate": "newData.isNumber()"
          },
          "limit": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },

    "userCouples": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId",
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50 && !data.exists()"
      }
    },

    "invites": {
      "$inviteCode": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid)",
        "createdBy": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "coupleId": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "pushTokens": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId",
        "token": {
          ".validate": "newData.isString() && newData.val().length <= 512"
        },
        "platform": {
          ".validate": "newData.isString() && newData.val().matches(/^(ios|android|web)$/)"
        },
        "coupleId": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
